<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_32">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@color/divider"
            android:importantForAccessibility="no" />

        <!-- Sheet title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✦"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/bg_icon_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Task Generator"
                    android:textAppearance="@style/TextAppearance.TM.TitleLarge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Powered by Google Gemini"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- PANEL 1 — INPUT -->
        <LinearLayout
            android:id="@+id/panelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_20"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What do you want to accomplish?"
                android:textAppearance="@style/TextAppearance.TM.TitleMedium" />

            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="e.g. Prepare Flutter interview, Plan Goa trip…"
                android:textColorHint="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.TM.BodyLarge"
                android:padding="@dimen/space_16"
                android:gravity="top|start"
                android:minHeight="80dp"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionDone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="Quick suggestions"
                android:textAppearance="@style/TextAppearance.TM.TitleSmall" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFlutter"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prepare Flutter interview"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoa"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Goa trip"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRoom"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organize my room"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAndroid"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learn Android"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWedding"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wedding planning"
                    android:textAppearance="@style/TextAppearance.TM.LabelMedium" />

            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:text="Cancel"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerate"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Generate"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    android:paddingStart="@dimen/space_24"
                    android:paddingEnd="@dimen/space_24"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/radius_md" />

            </LinearLayout>

        </LinearLayout>

        <!-- PANEL 2 — LOADING (skeleton pulse) -->
        <LinearLayout
            android:id="@+id/panelLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_20"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_20">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:text="Gemini is writing your task…"
                    android:textAppearance="@style/TextAppearance.TM.TitleMedium" />
            </LinearLayout>

            <!-- Skeleton placeholder bars, pulsed via ObjectAnimator in Kotlin -->
            <View
                android:id="@+id/skeletonLine1"
                android:layout_width="220dp"
                android:layout_height="18dp"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_skeleton" />

            <View
                android:id="@+id/skeletonLine2"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@drawable/bg_skeleton" />

            <View
                android:id="@+id/skeletonLine3"
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/space_20"
                android:background="@drawable/bg_skeleton" />

            <View
                android:id="@+id/skeletonLine4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_skeleton" />

        </LinearLayout>

        <!-- PANEL 3 — PREVIEW -->
        <LinearLayout
            android:id="@+id/panelPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_20"
                android:layout_marginTop="@dimen/space_16"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_1"
                app:cardBackgroundColor="@color/bg_main">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TM.TitleLarge"
                        tools:text="Prepare Flutter interview" />

                    <TextView
                        android:id="@+id/tvPreviewDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.TM.BodyMedium"
                        tools:text="Go through Flutter fundamentals and prepare answers for common interview questions." />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPriority"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipStrokeWidth="0dp"
                            tools:text="HIGH"
                            tools:chipBackgroundColor="@color/error_container" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCategory"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipStrokeWidth="0dp"
                            tools:text="Learning"
                            tools:chipBackgroundColor="@color/primary_light" />

                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗓"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDueDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.TM.BodyMedium"
                            tools:text="Due in 3 days" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_16"
                        android:layout_marginBottom="@dimen/space_12"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checklist"
                        android:textAppearance="@style/TextAppearance.TM.TitleSmall" />

                    <LinearLayout
                        android:id="@+id/layoutChecklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/space_8" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_20"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_8">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviewCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="Edit"
                    app:strokeColor="@color/primary"
                    android:textColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="Save"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/radius_md" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>