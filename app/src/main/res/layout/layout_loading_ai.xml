<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.AI"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="@dimen/spacing_none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="@dimen/spacing_100"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/color_ai_primary"
            app:trackColor="@color/color_ai_surface"
            app:trackCornerRadius="@dimen/radius_round"
            app:trackThickness="@dimen/spacing_4" />

        <TextView
            style="@style/TextAppearance.App.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="AI is thinking..."
            android:textColor="@color/color_ai_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>