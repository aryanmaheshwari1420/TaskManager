<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (primary border outline + bright surface) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1.5dp" android:color="@color/primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Normal state (subtle background + subtle border) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
