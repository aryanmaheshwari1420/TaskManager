<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (glowing primary bottom line) -->
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="0dp" android:left="-10dp" android:right="-10dp" android:top="-10dp">
                <shape>
                    <stroke android:width="2dp" android:color="@color/primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal state (divider color bottom line) -->
    <item>
        <layer-list>
            <item android:bottom="0dp" android:left="-10dp" android:right="-10dp" android:top="-10dp">
                <shape>
                    <stroke android:width="1dp" android:color="@color/divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
